{
  "name": "answerlens-workspace",
  "version": "0.3.3",
  "private": true,
  "description": "AnswerLens: CLI-first AI visibility auditor for product websites.",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "audit": "node --experimental-strip-types apps/cli/src/index.ts audit",
    "eval": "node --experimental-strip-types apps/cli/src/index.ts eval",
    "manual-import": "node --experimental-strip-types apps/cli/src/index.ts manual-import",
    "search-console-import": "node --experimental-strip-types apps/cli/src/index.ts search-console-import",
    "bing-indexnow-helper": "node --experimental-strip-types apps/cli/src/index.ts bing-indexnow-helper",
    "demo:fixture": "node --experimental-strip-types apps/cli/src/index.ts audit ./examples/fixtures/static-good --brand ./examples/acme/brand.yaml --competitors ./examples/acme/competitors.yaml --prompts ./examples/acme/prompts.yaml --out ./runs/static-good",
    "demo:consumer-repo": "node --experimental-strip-types apps/cli/src/index.ts audit ./examples/fixtures/static-good --brand ./examples/consumer-repo/.github/answerlens/brand.yaml --competitors ./examples/consumer-repo/.github/answerlens/competitors.yaml --prompts ./examples/consumer-repo/.github/answerlens/prompts.yaml --out ./runs/consumer-repo",
    "self-dogfood:pages": "node --experimental-strip-types apps/cli/src/index.ts audit https://yscjrh.github.io/ai-visibility-auditor/ --brand ./.github/answerlens/brand.yaml --competitors ./.github/answerlens/competitors.yaml --prompts ./.github/answerlens/prompts.yaml --out ./runs/self-dogfood-pages",
    "build:social-preview": "node --experimental-strip-types scripts/distribution/build-social-preview.ts",
    "build:cli": "corepack pnpm --dir apps/cli build",
    "build:admin": "corepack pnpm --dir apps/admin build",
    "admin:dev": "corepack pnpm --dir apps/admin dev",
    "pack:cli": "corepack pnpm --dir apps/cli pack --pack-destination ../../dist/packages",
    "pack:cli:dry-run": "corepack pnpm --dir apps/cli pack --dry-run",
    "build:site": "node --experimental-strip-types scripts/distribution/build-site.ts",
    "seo:check": "node --experimental-strip-types scripts/distribution/seo-check.ts",
    "public:check": "node --experimental-strip-types scripts/distribution/public-surface-check.ts",
    "test": "node --experimental-strip-types --experimental-test-isolation=none --test packages/core/src/audit.test.ts packages/core/src/eval.test.ts packages/core/src/validation.test.ts packages/providers/src/openai.test.ts packages/runtime-config/src/index.test.ts packages/report/src/index.test.ts packages/admin-runtime/src/index.test.ts apps/cli/src/index.test.ts scripts/distribution/build-site.test.ts scripts/distribution/seo-check.test.ts scripts/distribution/public-surface-check.test.ts scripts/distribution/build-social-preview.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.base.json && corepack pnpm --dir apps/admin typecheck"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "fast-xml-parser": "^4.5.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.14.0",
    "tsup": "^8.5.0",
    "typescript": "^5.7.3"
  }
}
