{
  "name": "@answerlens/admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"corepack pnpm run dev:server\" \"corepack pnpm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "node --watch --experimental-strip-types server/index.ts",
    "build": "corepack pnpm run typecheck && vite build",
    "preview": "node --experimental-strip-types server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@answerlens/admin-runtime": "workspace:*",
    "@answerlens/contracts": "workspace:*",
    "@tanstack/react-query": "^5.76.2",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.1.0",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.14.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3",
    "vite": "^5.4.19"
  }
}
